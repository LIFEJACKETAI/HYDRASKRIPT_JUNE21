# ─────────────────────────────────────────────
# HydraSkript — Environment Variables Template
# Copy this file to .env.local and fill in your keys
# cp .env.example .env.local
# ─────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────
# Local dev: SQLite (default, no setup needed)
# DATABASE_URL="file:./dev.db"

# Production: PostgreSQL (Supabase recommended)
# IMPORTANT: Use TRANSACTION POOLER (port 6543) for serverless/Vercel!
# Direct connection (port 5432) has a 15-connection hard limit in session mode.
# Get this from Supabase Dashboard → Settings → Database → Connection pooling
# Format: postgresql://postgres:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# DATABASE_URL="postgresql://postgres:***@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<ANON_KEY>"
# SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
# SUPABASE_STORAGE_BUCKET="hydraskript-assets"

# Prisma Connection Pool Tuning (Critical for Supabase)
# Supabase Free: ~60 connections via transaction pooler, Pro: 100-500+
# For Vercel serverless: 6-10 per instance is safe for moderate traffic.
# Too low (e.g. 3) causes P2028 "Unable to start a transaction" when the
# poll loop + queue worker + heartbeat all compete for connections.
# Formula: max = (plan_limit * 0.7) / max_concurrent_instances
DATABASE_POOL_MAX="10"
# Transaction timeout: LLM operations (editorial review, manuscript import) can take 60-120s.
# Must be long enough for the pool to hand out a connection under load.
# 30000 is the minimum; raise to 60000-120000 if you still see P2028 after increasing POOL_MAX.
PRISMA_TRANSACTION_TIMEOUT="30000"

# ── AI / LLM ──────────────────────────────────
# NVIDIA NIM — PRIMARY provider for all book/chapter text generation
# Get your key at: https://build.nvidia.com
# Valid NVIDIA NIM models (Sep 2026): nvidia/nemotron-3-super-120b-a12b,
# nvidia/nemotron-3.5-lightning-30b-a3b, google/gemma-4-31b-it.
# IMPORTANT: NIM model IDs MUST include a provider prefix (e.g. "nvidia/…",
# "google/…").  A bare name like "mistral-large-2411" is a Mistral AI model
# and will 404 on the NIM endpoint.  fallback.ts validates and skips invalid
# entries automatically, but set the correct prefix for best performance.
# NOTE: meta/llama-3.1-8b-instruct and meta/llama-3.1-70b-instruct are RETIRED
# (they return HTTP 410 Gone). These vars are optional — fallback.ts rotates
# through a built-in chain of valid models even if they are unset.
# NVIDIA_NIM_API_KEY="<YOUR_NVIDIA_NIM_KEY>"
# NVIDIA_NIM_API_URL="https://integrate.api.nvidia.com/v1/chat/completions"
# NVIDIA_NIM_MODEL is used for PROSE generation (chapter writing).
# NVIDIA_NIM_MODEL_JSON is used for JSON generation (outlines, schemas).
# Keep them separate so a model that works for JSON also works for prose.
# NVIDIA_NIM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# NVIDIA_NIM_MODEL_JSON="nvidia/nemotron-3-super-120b-a12b"

# OpenRouter — BACKUP provider (used on fallback if NVIDIA NIM fails)
# Get your key at: https://openrouter.ai/keys
# NOTE: :free models get retired/rate-limited periodically. List current ones:
# curl https://openrouter.ai/api/v1/models | jq '.data[].id' | grep ':free'
# OPENROUTER_API_KEY="<YOUR_OPENROUTER_KEY>"
# OPENROUTER_MODEL="google/gemma-4-31b-it:free"                 # optional preferred model

# Google AI / Gemini — TERTIARY text-generation fallback and image generation.
# Add this key to keep text generation available when both NVIDIA NIM and
# OpenRouter are unavailable. GEMINI_TEXT_MODEL is optional; fallback.ts will
# use gemini-3.6-flash if it is unset or the configured model is unavailable.
# NOTE: gemini-2.5-flash returns 404 for new Google AI projects — use
# gemini-3.6-flash or gemini-flash-latest instead.
# GOOGLE_AI_API_KEY="<YOUR_GOOGLE_AI_KEY>"
# GEMINI_TEXT_MODEL="gemini-3.6-flash"

# Mistral AI — QUATERNARY provider (excellent for structured JSON, editorial review)
# Get your key at: https://console.mistral.ai/
# Valid Mistral models (live-tested 14 Sep 2026): mistral-medium-3-5,
# mistral-small-2503, mistral-small-latest.
# `mistral-large-2411` returns HTTP 400 "Invalid model" — do NOT use.
# `mistral-large-latest` requires a higher tier (403 tier_not_allowed).
# EDITORIAL_REVIEW_MODEL defaults to Mistral for best JSON/structured output
# MISTRAL_API_KEY="<YOUR_MISTRAL_KEY>"
# MISTRAL_MODEL="mistral-medium-3-5"
# EDITORIAL_REVIEW_MODEL="mistral-medium-3-5"

# Z.AI — LLM provider
# Z_AI_API_KEY="<YOUR_ZAI_API_KEY>"

# ── IMAGE GENERATION ──────────────────────────
# Google Gemini Image Model
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# Stability AI (optional — for image generation fallback)
# STABILITY_AI_API_KEY="<YOUR_STABILITY_KEY>"

# Google OAuth (for authentication)
# GOOGLE_OAUTH_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID>"
# GOOGLE_OAUTH_CLIENT_SECRET="<YOUR_GOOGLE_CLIENT_SECRET>"

# ── PAYMENTS ──────────────────────────────────
# Stripe — used for credit purchases
# Get your keys at: https://dashboard.stripe.com/api-keys
# STRIPE_SECRET_KEY="<YOUR_STRIPE_SECRET_KEY>"
# STRIPE_PUBLISHABLE_KEY="<YOUR_STRIPE_PUBLISHABLE_KEY>"
# STRIPE_WEBHOOK_SECRET="<YOUR_STRIPE_WEBHOOK_SECRET>"

# Price IDs (create or reuse in Stripe Dashboard)
# STRIPE_PRICE_STARTER="<price_id>"
# STRIPE_PRICE_AUTHOR="<price_id>"
# STRIPE_PRICE_PUBLISHER="<price_id>"
# STRIPE_PRICE_STUDIO="<price_id>"
# STRIPE_PRICE_PACK_100="<price_id>"
# STRIPE_PRICE_PACK_500="<price_id>"
# STRIPE_PRICE_PACK_1000="<price_id>"
# STRIPE_PRICE_FOUNDER_399="<price_id>" # Founder Early Bird $399 one-time
# STRIPE_PRICE_FOUNDER_499="<price_id>" # Founder Standard $499 one-time

# ── AUTH ──────────────────────────────────────
# NextAuth secret — generate with: openssl rand -base64 32
# NEXTAUTH_SECRET="<GENERATED_SECRET>"
# NEXTAUTH_URL="http://localhost:3002"

# ── FILE STORAGE (Production only) ────────────
# Cloudflare R2 — for persistent image/audio storage
# R2_ACCOUNT_ID="<YOUR_R2_ACCOUNT_ID>"R2_ACCESS_KEY_ID="<YOUR_R2_ACCESS_KEY>"
# R2_SECRET_ACCESS_KEY="<YOUR_R2_SECRET_KEY>"
# R2_BUCKET_KEY="<YOUR_R2_BUCKET_KEY>"
# R2_PUBLIC_URL="https://<BUCKET>.<ACCOUNT_ID>.r2.cloudflarestorage.com"

# ── APP ───────────────────────────────────────
# NEXT_PUBLIC_APP_URL="http://localhost:3002"
# NODE_ENV="development"